{
  "name": "Komari Next",
  "short": "komari",
  "description": "NextJS theme for Komari Monitor",
  "version": "1.6.3",
  "author": "Komari",
  "url": "https://github.com/tonyliuzj/komari-next",
  "preview": "preview.png",
  "configuration": {
    "type": "managed",
    "name": "主题设置",
    "data": [
      { "type": "title", "name": "主题设置" },
      {
        "key": "colorTheme", "type": "select", "name": "默认颜色主题",
        "help": "设置主题默认颜色方案，访客仍可在本地覆盖。",
        "default": "default", "options": "default,ocean,sunset,forest,midnight,rose"
      },
      { "key": "cardLayout", "type": "select", "name": "默认卡片布局", "default": "classic", "options": "classic,modern,minimal,detailed" },
      { "key": "cardDesign", "type": "select", "name": "默认卡片设计", "default": "default", "options": "default,quality-bars" },
      { "key": "cardBlurEnabled", "type": "switch", "name": "启用卡片背景模糊", "default": false },
      { "key": "cardBlurType", "type": "select", "name": "卡片背景模糊类型", "default": "glass", "options": "soft,glass" },
      { "key": "cardBlurIntensity", "type": "number", "name": "卡片背景透明强度", "default": 35 },
      { "key": "cardExtraBlurIntensity", "type": "number", "name": "卡片背景额外模糊强度", "default": 35 },
      { "key": "statusDesign", "type": "select", "name": "默认状态设计", "default": "default", "options": "default,speed" },
      { "key": "graphDesign", "type": "select", "name": "默认图表设计", "default": "circle", "options": "circle,progress,bar,minimal" },
      { "key": "nodeViewMode", "type": "select", "name": "默认节点视图", "default": "grid", "options": "grid,table" },
      { "key": "appearance", "type": "select", "name": "默认外观", "default": "system", "options": "light,dark,system" },
      {
        "key": "language", "type": "select", "name": "默认语言",
        "help": "选择 auto 时使用访客浏览器语言。",
        "default": "auto", "options": "auto,en,zh-CN,zh-TW"
      },
      { "key": "backgroundImageUrl", "type": "string", "name": "背景图片链接", "default": "" },
      { "key": "backgroundBlurEnabled", "type": "switch", "name": "启用背景模糊", "default": false },
      { "key": "backgroundBlurType", "type": "select", "name": "背景模糊类型", "default": "soft", "options": "soft,glass" },
      { "key": "backgroundBlurIntensity", "type": "number", "name": "背景模糊强度", "default": 35 },
      { "type": "title", "name": "状态卡片" },
      { "key": "statusCardsVisibility.currentTime", "type": "switch", "name": "显示当前时间", "default": true },
      { "key": "statusCardsVisibility.currentOnline", "type": "switch", "name": "显示当前在线", "default": true },
      { "key": "statusCardsVisibility.regionOverview", "type": "switch", "name": "显示点亮地区", "default": true },
      { "key": "statusCardsVisibility.trafficOverview", "type": "switch", "name": "显示流量概览", "default": true },
      { "key": "statusCardsVisibility.networkSpeed", "type": "switch", "name": "显示网络速率", "default": true },
      { "key": "statusCardsVisibility.mapView", "type": "switch", "name": "显示地图", "default": true }
    ]
  }
}
